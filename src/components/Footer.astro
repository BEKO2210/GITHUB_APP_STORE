---
const base = import.meta.env.BASE_URL ?? '/GITHUB_APP_STORE';
const year = new Date().getFullYear();
---

<footer class="border-t border-border py-8 mt-16">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-text-muted text-sm">
      <p>&copy; {year} GitHub APK Store. Open source.</p>
      <nav class="flex gap-6" aria-label="Footer navigation">
        <a href={`${base}/about`} class="hover:text-text-secondary transition-colors">About</a>
        <a href={`${base}/privacy`} class="hover:text-text-secondary transition-colors">Privacy</a>
        <a href="https://github.com/BEKO2210/GITHUB_APP_STORE" target="_blank" rel="noopener noreferrer" class="hover:text-text-secondary transition-colors">Source</a>
      </nav>
    </div>
  </div>
</footer>
