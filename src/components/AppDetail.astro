---
import CategoryBadge from './CategoryBadge.astro';
import DownloadButton from './DownloadButton.astro';
import type { AppEntry } from '../types/app';

interface Props {
  app: AppEntry;
}

const { app } = Astro.props;

const lastUpdated = new Date(app.lastUpdated).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="mx-auto max-w-4xl px-4 py-8 sm:px-6 lg:px-8">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row items-start gap-4">
    {app.icon ? (
      <img src={app.icon} alt={`${app.name} icon`} width="80" height="80" class="rounded-2xl bg-elevated" loading="eager" decoding="async" />
    ) : (
      <div class="w-20 h-20 rounded-2xl bg-elevated flex items-center justify-center text-text-muted text-2xl font-bold" aria-hidden="true">
        {app.name.charAt(0)}
      </div>
    )}
    <div class="flex-1">
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-text-primary">{app.name}</h1>
      <p class="mt-1">
        <a href={app.authorUrl} target="_blank" rel="noopener noreferrer" class="text-text-secondary hover:text-text-primary transition-colors">
          {app.author}
        </a>
      </p>
      <div class="mt-2 flex flex-wrap items-center gap-2">
        <CategoryBadge category={app.category} />
        {app.license && (
          <span class="inline-flex items-center rounded-full border border-border bg-surface px-3 py-1 text-xs font-medium text-text-muted">
            {app.license}
          </span>
        )}
        {app.isVerified && (
          <span class="inline-flex items-center rounded-full border border-success/30 bg-success/10 px-3 py-1 text-xs font-medium text-success">
            Verified
          </span>
        )}
      </div>
    </div>
  </div>

  <!-- Download CTA -->
  <div class="mt-6">
    <DownloadButton releaseUrl={app.releaseUrl} version={app.version} sizeFormatted={app.sizeFormatted} />
  </div>

  <!-- Description -->
  <section class="mt-8">
    <h2 class="text-lg font-bold text-text-primary mb-2">About</h2>
    <p class="text-text-secondary leading-relaxed">{app.description}</p>
  </section>

  <!-- Screenshots -->
  {app.screenshots.length > 0 && (
    <section class="mt-8">
      <h2 class="text-lg font-bold text-text-primary mb-3">Screenshots</h2>
      <div class="flex gap-3 overflow-x-auto pb-4 -mx-4 px-4" role="region" aria-label="App screenshots">
        {app.screenshots.map((src, i) => (
          <img src={src} alt={`${app.name} screenshot ${i + 1}`} class="h-64 rounded-xl border border-border" loading="lazy" decoding="async" width="144" height="256" />
        ))}
      </div>
    </section>
  )}

  <!-- Metadata grid -->
  <section class="mt-8" aria-label="App details">
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
      <div class="rounded-lg border border-border bg-surface p-3">
        <p class="text-xs text-text-muted">Version</p>
        <p class="text-sm font-medium text-text-primary mt-1">{app.version}</p>
      </div>
      <div class="rounded-lg border border-border bg-surface p-3">
        <p class="text-xs text-text-muted">Size</p>
        <p class="text-sm font-medium text-text-primary mt-1">{app.sizeFormatted}</p>
      </div>
      <div class="rounded-lg border border-border bg-surface p-3">
        <p class="text-xs text-text-muted">Stars</p>
        <p class="text-sm font-medium text-text-primary mt-1">{app.stars.toLocaleString()}</p>
      </div>
      <div class="rounded-lg border border-border bg-surface p-3">
        <p class="text-xs text-text-muted">Forks</p>
        <p class="text-sm font-medium text-text-primary mt-1">{app.forks.toLocaleString()}</p>
      </div>
      <div class="rounded-lg border border-border bg-surface p-3">
        <p class="text-xs text-text-muted">Last Updated</p>
        <p class="text-sm font-medium text-text-primary mt-1">
          <time datetime={app.lastUpdated}>{lastUpdated}</time>
        </p>
      </div>
      <div class="rounded-lg border border-border bg-surface p-3">
        <p class="text-xs text-text-muted">Language</p>
        <p class="text-sm font-medium text-text-primary mt-1">{app.language ?? 'N/A'}</p>
      </div>
      <div class="rounded-lg border border-border bg-surface p-3">
        <p class="text-xs text-text-muted">Open Issues</p>
        <p class="text-sm font-medium text-text-primary mt-1">{app.openIssues.toLocaleString()}</p>
      </div>
      <div class="rounded-lg border border-border bg-surface p-3">
        <p class="text-xs text-text-muted">License</p>
        <p class="text-sm font-medium text-text-primary mt-1">{app.license ?? 'Not specified'}</p>
      </div>
    </div>
  </section>

  <!-- Links -->
  <nav class="mt-8 flex flex-wrap gap-3" aria-label="External links">
    <a href={app.repoUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-lg border border-border bg-surface px-4 py-2 text-sm text-text-secondary hover:text-text-primary hover:border-accent-hover transition-colors">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
      </svg>
      View Source
    </a>
    <a href={app.releaseUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-lg border border-border bg-surface px-4 py-2 text-sm text-text-secondary hover:text-text-primary hover:border-accent-hover transition-colors">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
        <polyline points="15 3 21 3 21 9" />
        <line x1="10" y1="14" x2="21" y2="3" />
      </svg>
      Release Page
    </a>
  </nav>
</article>
