---
interface Props {
  category: string;
  href?: string;
}

const { category, href } = Astro.props;
const base = import.meta.env.BASE_URL ?? '/GITHUB_APP_STORE';
const label = category.charAt(0).toUpperCase() + category.slice(1);
const link = href ?? `${base}/category/${category}`;
---

<a
  href={link}
  class="inline-flex items-center rounded-full border border-border bg-surface px-3 py-1 text-xs font-medium text-text-secondary hover:text-text-primary hover:border-accent-hover transition-colors"
>
  {label}
</a>
