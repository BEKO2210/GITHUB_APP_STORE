---
interface Props {
  releaseUrl: string;
  version: string;
  sizeFormatted: string;
}

const { releaseUrl, version, sizeFormatted } = Astro.props;
---

<a
  href={releaseUrl}
  target="_blank"
  rel="noopener noreferrer"
  class="inline-flex items-center gap-2 rounded-lg bg-accent text-black font-semibold px-6 py-3 hover:bg-accent-hover transition-colors focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-black"
>
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
    <polyline points="7 10 12 15 17 10" />
    <line x1="12" y1="15" x2="12" y2="3" />
  </svg>
  <span>Download {version}</span>
  <span class="text-sm opacity-75">({sizeFormatted})</span>
</a>
