---
import CategoryBadge from './CategoryBadge.astro';
import type { AppEntry } from '../types/app';

interface Props {
  app: AppEntry;
}

const { app } = Astro.props;
const base = import.meta.env.BASE_URL ?? '/GITHUB_APP_STORE';

function formatStars(n: number): string {
  if (n >= 1000) return `${(n / 1000).toFixed(1)}k`;
  return String(n);
}

const timeAgo = (() => {
  const diff = Date.now() - new Date(app.lastUpdated).getTime();
  const days = Math.floor(diff / (1000 * 60 * 60 * 24));
  if (days < 1) return 'today';
  if (days === 1) return '1 day ago';
  if (days < 30) return `${days} days ago`;
  if (days < 365) return `${Math.floor(days / 30)} months ago`;
  return `${Math.floor(days / 365)} years ago`;
})();
---

<a href={`${base}/apps/${app.id}`} class="group block rounded-xl border border-border bg-surface p-4 hover:border-accent-hover hover:bg-elevated transition-all duration-200 focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-black" data-pagefind-body aria-label={`${app.name} by ${app.author}`}>
  <div class="flex items-start gap-3">
    {app.icon ? (
      <img src={app.icon} alt="" width="48" height="48" class="rounded-xl bg-elevated" loading="lazy" decoding="async" />
    ) : (
      <div class="w-12 h-12 rounded-xl bg-elevated flex items-center justify-center text-text-muted text-lg font-bold" aria-hidden="true">
        {app.name.charAt(0)}
      </div>
    )}
    <div class="flex-1 min-w-0">
      <h3 class="font-bold text-text-primary truncate group-hover:text-accent-hover transition-colors">{app.name}</h3>
      <p class="text-sm text-text-secondary truncate">{app.author}</p>
    </div>
  </div>

  <p class="mt-3 text-sm text-text-secondary line-clamp-2 leading-relaxed">{app.description}</p>

  <div class="mt-3 flex items-center justify-between">
    <CategoryBadge category={app.category} />
    <div class="flex items-center gap-3 text-xs text-text-muted">
      <span class="flex items-center gap-1" title={`${app.stars} stars`}>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
        </svg>
        {formatStars(app.stars)}
      </span>
      <time datetime={app.lastUpdated}>{timeAgo}</time>
    </div>
  </div>
</a>
