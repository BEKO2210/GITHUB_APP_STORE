---
import Base from '../layouts/Base.astro';
import AppCard from '../components/AppCard.astro';
import type { AppEntry, CategoryEntry } from '../types/app';

const apps: AppEntry[] = await import('../data/apps.json').then((m) => m.default as unknown as AppEntry[]);
const categories: CategoryEntry[] = await import('../data/categories.json').then((m) => m.default as unknown as CategoryEntry[]);
const base = import.meta.env.BASE_URL ?? '/GITHUB_APP_STORE';

// Group apps by category, sorted by stars within each category
const appsByCategory = new Map<string, AppEntry[]>();
for (const app of apps) {
  const cat = app.category || 'unknown';
  if (!appsByCategory.has(cat)) appsByCategory.set(cat, []);
  appsByCategory.get(cat)!.push(app);
}

// Sort categories: by count descending, "unknown" last
const sortedCategories = [...categories].sort((a, b) => {
  if (a.slug === 'unknown') return 1;
  if (b.slug === 'unknown') return -1;
  return b.count - a.count;
});
---

<Base
  title="Search & Browse — GitHub APK Store"
  description="Search and browse open-source Android apps by category from GitHub releases."
  canonicalPath="/search"
>
  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <!-- Search input -->
    <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-text-primary text-center mb-6">Search & Browse Apps</h1>

    <div class="w-full max-w-2xl mx-auto mb-8">
      <div class="relative">
        <svg class="absolute left-3 top-1/2 -translate-y-1/2 text-text-muted pointer-events-none" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8" />
          <line x1="21" y1="21" x2="16.65" y2="16.65" />
        </svg>
        <input
          type="search"
          id="app-search"
          placeholder="Search apps by name, author, or description..."
          autocomplete="off"
          class="w-full rounded-xl border border-border bg-surface pl-10 pr-4 py-3 text-text-primary placeholder:text-text-muted focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20 transition-colors"
        />
      </div>
    </div>

    <!-- Category filter pills -->
    <nav class="mb-8" aria-label="Category filters">
      <div class="flex flex-wrap gap-2 justify-center">
        <button
          type="button"
          data-category="all"
          class="category-btn active inline-flex items-center gap-1.5 rounded-full border border-border bg-surface px-4 py-2 text-sm font-medium text-text-secondary hover:text-text-primary hover:border-accent-hover transition-colors"
          aria-pressed="true"
        >
          All
          <span class="text-xs text-text-muted">({apps.length})</span>
        </button>
        {sortedCategories.map((cat) => (
          <button
            type="button"
            data-category={cat.slug}
            class="category-btn inline-flex items-center gap-1.5 rounded-full border border-border bg-surface px-4 py-2 text-sm font-medium text-text-secondary hover:text-text-primary hover:border-accent-hover transition-colors"
            aria-pressed="false"
          >
            {cat.label}
            <span class="text-xs text-text-muted">({cat.count})</span>
          </button>
        ))}
      </div>
    </nav>

    <!-- Sort controls -->
    <div class="flex items-center justify-between mb-6">
      <p id="result-count" class="text-sm text-text-muted">
        Showing <strong class="text-text-secondary">{apps.length}</strong> apps
      </p>
      <div class="flex items-center gap-2">
        <label for="sort-select" class="text-sm text-text-muted">Sort:</label>
        <select id="sort-select" class="rounded-lg border border-border bg-surface text-text-secondary text-sm px-3 py-1.5 focus:border-accent focus:outline-none">
          <option value="stars">Stars</option>
          <option value="name">Name (A-Z)</option>
          <option value="updated">Recently Updated</option>
          <option value="added">Recently Added</option>
          <option value="size">Size</option>
        </select>
      </div>
    </div>

    <!-- App grid -->
    <div id="app-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
      {apps.map((app) => (
        <div class="app-item" data-name={app.name.toLowerCase()} data-author={app.author.toLowerCase()} data-description={app.description.toLowerCase()} data-category={app.category || 'unknown'} data-stars={app.stars} data-updated={app.lastUpdated} data-added={app.addedAt} data-size={app.size}>
          <AppCard app={app} />
        </div>
      ))}
    </div>

    <!-- No results message -->
    <div id="no-results" class="hidden text-center py-16">
      <svg class="mx-auto mb-4 text-text-muted" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8" />
        <line x1="21" y1="21" x2="16.65" y2="16.65" />
        <line x1="8" y1="11" x2="14" y2="11" />
      </svg>
      <p class="text-text-secondary font-medium">No apps found</p>
      <p class="text-sm text-text-muted mt-1">Try adjusting your search or filter</p>
    </div>

    <!-- Load more button for performance (show 50 at a time) -->
    <div id="load-more-wrapper" class="text-center mt-8">
      <button id="load-more-btn" type="button" class="inline-flex items-center gap-2 rounded-lg border border-border bg-surface px-6 py-3 text-sm font-medium text-text-secondary hover:text-text-primary hover:border-accent-hover transition-colors">
        Load More Apps
      </button>
    </div>
  </section>
</Base>

<style>
  .category-btn.active {
    border-color: #ffffff;
    color: #ffffff;
    background-color: #141414;
  }
  .app-item.hidden-by-filter {
    display: none;
  }
</style>

<script>
  const BATCH_SIZE = 48;
  let visibleCount = BATCH_SIZE;
  let activeCategory = 'all';
  let searchQuery = '';
  let currentSort = 'stars';

  const searchInput = document.getElementById('app-search') as HTMLInputElement;
  const grid = document.getElementById('app-grid')!;
  const items = Array.from(grid.querySelectorAll('.app-item')) as HTMLElement[];
  const resultCount = document.getElementById('result-count')!;
  const noResults = document.getElementById('no-results')!;
  const loadMoreBtn = document.getElementById('load-more-btn')!;
  const loadMoreWrapper = document.getElementById('load-more-wrapper')!;
  const categoryBtns = document.querySelectorAll('.category-btn') as NodeListOf<HTMLElement>;
  const sortSelect = document.getElementById('sort-select') as HTMLSelectElement;

  function getFilteredItems(): HTMLElement[] {
    return items.filter((el) => {
      const matchesCategory = activeCategory === 'all' || el.dataset.category === activeCategory;
      if (!matchesCategory) return false;
      if (!searchQuery) return true;
      const q = searchQuery.toLowerCase();
      return (
        el.dataset.name!.includes(q) ||
        el.dataset.author!.includes(q) ||
        el.dataset.description!.includes(q)
      );
    });
  }

  function sortItems(filtered: HTMLElement[]): HTMLElement[] {
    return filtered.sort((a, b) => {
      switch (currentSort) {
        case 'stars':
          return Number(b.dataset.stars) - Number(a.dataset.stars);
        case 'name':
          return a.dataset.name!.localeCompare(b.dataset.name!);
        case 'updated':
          return new Date(b.dataset.updated!).getTime() - new Date(a.dataset.updated!).getTime();
        case 'added':
          return new Date(b.dataset.added!).getTime() - new Date(a.dataset.added!).getTime();
        case 'size':
          return Number(a.dataset.size) - Number(b.dataset.size);
        default:
          return 0;
      }
    });
  }

  function render() {
    const filtered = sortItems(getFilteredItems());

    // Hide all items first
    for (const el of items) {
      el.classList.add('hidden-by-filter');
    }

    // Re-append sorted items and show up to visibleCount
    for (let i = 0; i < filtered.length; i++) {
      grid.appendChild(filtered[i]);
      if (i < visibleCount) {
        filtered[i].classList.remove('hidden-by-filter');
      }
    }

    const shown = Math.min(visibleCount, filtered.length);
    resultCount.innerHTML = `Showing <strong class="text-text-secondary">${shown}</strong> of <strong class="text-text-secondary">${filtered.length}</strong> apps`;
    noResults.classList.toggle('hidden', filtered.length > 0);
    loadMoreWrapper.classList.toggle('hidden', visibleCount >= filtered.length);
  }

  // Search
  let debounceTimer: ReturnType<typeof setTimeout>;
  searchInput.addEventListener('input', () => {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(() => {
      searchQuery = searchInput.value.trim();
      visibleCount = BATCH_SIZE;
      render();
    }, 200);
  });

  // Category filter
  for (const btn of categoryBtns) {
    btn.addEventListener('click', () => {
      for (const b of categoryBtns) {
        b.classList.remove('active');
        b.setAttribute('aria-pressed', 'false');
      }
      btn.classList.add('active');
      btn.setAttribute('aria-pressed', 'true');
      activeCategory = btn.dataset.category!;
      visibleCount = BATCH_SIZE;
      render();
    });
  }

  // Sort
  sortSelect.addEventListener('change', () => {
    currentSort = sortSelect.value;
    render();
  });

  // Load more
  loadMoreBtn.addEventListener('click', () => {
    visibleCount += BATCH_SIZE;
    render();
  });

  // Initial render — hide items beyond first batch
  render();
</script>
