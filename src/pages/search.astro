---
import Base from '../layouts/Base.astro';
import SearchBar from '../components/SearchBar.astro';
---

<Base
  title="Search — GitHub APK Store"
  description="Search for open-source Android apps from GitHub releases."
  canonicalPath="/search"
>
  <section class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-16">
    <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-text-primary text-center mb-8">Search Apps</h1>
    <SearchBar />
  </section>
</Base>
