---
import Base from '../../layouts/Base.astro';
import AppCard from '../../components/AppCard.astro';
import type { AppEntry, CategoryEntry } from '../../types/app';

export async function getStaticPaths() {
  const apps: AppEntry[] = await import('../../data/apps.json').then((m) => m.default as unknown as AppEntry[]);
  const categories: CategoryEntry[] = await import('../../data/categories.json').then((m) => m.default as unknown as CategoryEntry[]);

  return categories.map((cat) => ({
    params: { slug: cat.slug },
    props: {
      category: cat,
      apps: apps.filter((a) => a.category === cat.slug),
    },
  }));
}

interface Props {
  category: CategoryEntry;
  apps: AppEntry[];
}

const { category, apps } = Astro.props;
const base = import.meta.env.BASE_URL;

// Sort by stars by default
const sortedApps = [...apps].sort((a, b) => b.stars - a.stars);
---

<Base
  title={`${category.label} Apps — GitHub APK Store`}
  description={category.description}
  canonicalPath={`/category/${category.slug}`}
>
  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12">
    <!-- Breadcrumb -->
    <nav class="mb-6" aria-label="Breadcrumb">
      <ol class="flex items-center gap-2 text-sm text-text-muted">
        <li><a href={`${base}/`} class="hover:text-text-secondary transition-colors">Home</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-text-secondary">{category.label}</li>
      </ol>
    </nav>

    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-8">
      <div>
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-text-primary">{category.label}</h1>
        <p class="mt-2 text-text-secondary">{category.description}</p>
        <p class="mt-1 text-sm text-text-muted">{category.count} app{category.count !== 1 ? 's' : ''}</p>
      </div>
      <div class="flex items-center gap-2">
        <label for="cat-sort" class="text-sm text-text-muted">Sort:</label>
        <select id="cat-sort" class="rounded-lg border border-border bg-surface text-text-secondary text-sm px-3 py-1.5 focus:border-accent focus:outline-none">
          <option value="stars">Stars</option>
          <option value="name">Name (A-Z)</option>
          <option value="updated">Recently Updated</option>
          <option value="added">Recently Added</option>
        </select>
      </div>
    </div>

    <div id="cat-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
      {sortedApps.map((app) => (
        <div class="cat-item" data-name={app.name.toLowerCase()} data-stars={app.stars} data-updated={app.lastUpdated} data-added={app.addedAt}>
          <AppCard app={app} />
        </div>
      ))}
    </div>
  </section>
</Base>

<script>
  const grid = document.getElementById('cat-grid');
  const sortSelect = document.getElementById('cat-sort') as HTMLSelectElement | null;
  if (grid && sortSelect) {
    const items = Array.from(grid.querySelectorAll('.cat-item')) as HTMLElement[];
    sortSelect.addEventListener('change', () => {
      const sorted = [...items].sort((a, b) => {
        switch (sortSelect.value) {
          case 'stars': return Number(b.dataset.stars) - Number(a.dataset.stars);
          case 'name': return a.dataset.name!.localeCompare(b.dataset.name!);
          case 'updated': return new Date(b.dataset.updated!).getTime() - new Date(a.dataset.updated!).getTime();
          case 'added': return new Date(b.dataset.added!).getTime() - new Date(a.dataset.added!).getTime();
          default: return 0;
        }
      });
      for (const el of sorted) grid.appendChild(el);
    });
  }
</script>
